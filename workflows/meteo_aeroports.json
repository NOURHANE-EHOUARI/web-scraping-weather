    {
      "parameters": {
        "jsCode": "const departWeather = $('Get_Weather_Depart').all();\nconst arriveeWeather = $('Get_Weather_Arrivee').all();\nconst flights = $('Match_Coordinate').all();\n\nconst result = [];\n\nfor (let i = 0; i < flights.length; i++) {\n  const f = flights[i].json;\n  const wd = departWeather[i]?.json?.daily;\n  const wa = arriveeWeather[i]?.json?.daily;\n\n  result.push({\n    json: {\n      flight_number: f.flight_number,\n      date_depart: f.date_depart,\n      depart_iata: f.depart_iata,\n      depart_ville: f.depart_ville,\n      arrivee_iata: f.arrivee_iata,\n      arrivee_ville: f.arrivee_ville,\n      statut: f.statut,\n      temp_max_depart: wd?.temperature_2m_max?.[0] ?? null,\n      temp_min_depart: wd?.temperature_2m_min?.[0] ?? null,\n      precipitation_depart: wd?.precipitation_sum?.[0] ?? null,\n      vent_depart: wd?.windspeed_10m_max?.[0] ?? null,\n      temp_max_arrivee: wa?.temperature_2m_max?.[0] ?? null,\n      temp_min_arrivee: wa?.temperature_2m_min?.[0] ?? null,\n      precipitation_arrivee: wa?.precipitation_sum?.[0] ?? null,\n      vent_arrivee: wa?.windspeed_10m_max?.[0] ?? null,\n    }\n  });\n}\n\nreturn result;"
      },
