      "name": "Get_Airports_DB"
    },
    {
      "parameters": {
        "jsCode": "const iataIndex = $('Slim_Airports_DB').first().json;\nconst flights = $('Extract_Flights').all();\n\nconsole.log('Nombre de clés IATA dans l\\'index:', Object.keys(iataIndex).length);\nconsole.log('Exemple de clés IATA:', Object.keys(iataIndex).slice(0, 5));\nconsole.log('Nombre de vols:', flights.length);\nconsole.log('Premier vol depart_iata:', flights[0]?.json?.depart_iata);\nconsole.log('Premier vol arrivee_iata:', flights[0]?.json?.arrivee_iata);\n\nconst result = [];\nlet matched = 0;\nlet notMatched = 0;\n\nfor (const item of flights) {\n  const f = item.json;\n  const dep = iataIndex[f.depart_iata];\n  const arr = iataIndex[f.arrivee_iata];\n\n  if (!dep || !arr) {\n    notMatched++;\n    continue;\n  }\n\n  matched++;\n  result.push({\n    json: {\n      ...f,\n      depart_lat: dep.lat,\n      depart_lon: dep.lon,\n      depart_ville: dep.city,\n      arrivee_lat: arr.lat,\n      arrivee_lon: arr.lon,\n      arrivee_ville: arr.city\n    }\n  });\n}\n\nconsole.log('Vols matchés:', matched, '| Vols non matchés:', notMatched);\nconsole.log('Résultat final (result.length):', result.length);\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
