      "name": "Get_Flights_API"
    },
    {
      "parameters": {
        "jsCode": "const airportsRaw = $input.first().json;\n\nconst iataIndex = {};\nfor (const icao in airportsRaw) {\n  const a = airportsRaw[icao];\n  if (a && a.iata) {\n    iataIndex[a.iata] = { lat: a.lat, lon: a.lon, city: a.city };\n  }\n}\n\nreturn [{ json: iataIndex }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -784
      ],
      "id": "69a7681d-93aa-4599-b953-c735e40d7cb5",
      "name": "Slim_Airports_DB"
    },
    {
      "parameters": {
        "jsCode": "const flights = $input.first().json.data;\n\nconst result = [];\n\nfor (const f of flights) {\n  // On ignore les vols annulés, pas pertinents pour la météo\n  if (f.flight_status === 'cancelled') continue;\n\n  result.push({\n    json: {\n      flight_number: f.flight.iata,\n      depart_iata: f.departure.iata,\n      depart_airport: f.departure.airport,\n      arrivee_iata: f.arrival.iata,\n      arrivee_airport: f.arrival.airport,\n      date_depart: f.departure.scheduled ? f.departure.scheduled.split('T')[0] : null,\n      heure_depart_utc: f.departure.scheduled,\n      statut: f.flight_status\n    }\n  });\n}\n\nreturn result;"
      },
